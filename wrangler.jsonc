{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainlodestones-com-v1",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Invoke Worker before assets so www/http redirects and /404* handling run
    "run_worker_first": true,
    // Match Astro trailingSlash: 'always'
    "html_handling": "force-trailing-slash",
    // Serve dist/404.html with HTTP 404 for unknown paths (stops empty-body 404s)
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
