---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ACQUISITION_EMAIL } from '../lib/constants';

const title = 'Privacy Policy | brainlodestones.com';
const description =
  'How brainlodestones.com handles inquiry data: what we collect when you contact us about the domain, how it is used, stored, and your choices.';
---

<BaseLayout title={title} description={description}>
  <Nav />

  <main id="main" class="pt-20">
    <article class="max-w-3xl mx-auto px-6 md:px-10 py-16">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-8">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="hover:text-teal-400 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-300">Privacy Policy</li>
        </ol>
      </nav>

      <h1 class="font-display text-3xl sm:text-4xl tracking-tight">Privacy Policy</h1>
      <p class="mt-3 text-sm text-slate-400">Last updated: October 6, 2026</p>

      <div class="prose-blog mt-8">
        <p>
          This policy explains what information we collect on brainlodestones.com,
          why we collect it, and what we do with it. The site is operated to market
          a single domain name for sale.
        </p>

        <h2>What we collect</h2>
        <p>
          When you submit an inquiry — through the acquisition form, the
          “terms by email” form, or a mail link — we receive the information you
          choose to provide: your name, email address, phone number (optional),
          intended use of the domain, and the content of your message.
        </p>
        <p>
          We also receive standard technical data that any web server sees, such as
          IP address, browser type, and the page requested, for security and abuse
          prevention purposes.
        </p>

        <h2>How we use it</h2>
        <ul>
          <li>To respond to your inquiry about the domain, typically within 24 hours.</li>
          <li>To prepare and negotiate acquisition terms you have asked for.</li>
          <li>To protect the site from spam, abuse, and fraudulent submissions.</li>
          <li>To meet legal obligations and keep basic transaction records.</li>
        </ul>
        <p>
          We do <strong>not</strong> sell, rent, or trade your information. We do not
          use it for third-party advertising, and we do not enroll you in a marketing
          list without a separate, explicit request.
        </p>

        <h2>Storage and security</h2>
        <p>
          Inquiry data is stored in encrypted infrastructure operated by Cloudflare,
          where this site is hosted. Access is limited to the person handling
          acquisition inquiries. Data is retained only as long as needed to respond,
          negotiate a transaction, or satisfy legal record-keeping requirements, and
          is then deleted.
        </p>
        <p>
          Transmission to this site is protected by HTTPS (TLS). No method of
          transmission or storage is perfectly secure, but we limit collection to what
          the conversation actually requires.
        </p>

        <h2>Analytics</h2>
        <p>
          The site may use Cloudflare Web Analytics, which measures page views and
          traffic sources without setting advertising cookies or collecting
          personally identifiable information. It is not used to build profiles of
          individual visitors.
        </p>

        <h2>Cookies</h2>
        <p>
          This site does not set advertising or tracking cookies. A session storage
          entry may be used to remember that you have already seen an on-page prompt,
          and it disappears when you close the tab.
        </p>

        <h2>Third-party links</h2>
        <p>
          The site links to third-party services (for example, escrow providers).
          Their privacy practices are governed by their own policies.
        </p>

        <h2>Your choices and rights</h2>
        <p>
          You may ask what data we hold about you, request a correction, or ask us to
          delete it, subject to any record-keeping we are legally required to
          maintain. Write to <a href={`mailto:${ACQUISITION_EMAIL}`}>{ACQUISITION_EMAIL}</a>
          and we will respond within a reasonable period.
        </p>

        <h2>Children</h2>
        <p>
          This site is directed at business buyers and is not intended for children,
          and we do not knowingly collect information from children.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          If the way we handle information changes materially, this page will be
          updated with a new date at the top.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about this policy: <a href={`mailto:${ACQUISITION_EMAIL}`}>{ACQUISITION_EMAIL}</a>.
        </p>
      </div>

      <div class="mt-12">
        <a
          href="/"
          class="inline-flex min-h-[48px] items-center rounded-2xl border border-slate-700 px-6 text-sm font-medium text-slate-300 transition-colors hover:border-teal-400/50 hover:text-white"
        >
          ← Back to brainlodestones.com
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
