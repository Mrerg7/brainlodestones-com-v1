---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ACQUISITION_EMAIL } from '../lib/constants';

const title = 'Terms of Use | brainlodestones.com';
const description =
  'Terms of use for brainlodestones.com, including how domain offers, escrow transactions, and site content are handled.';
---

<BaseLayout title={title} description={description}>
  <Nav />

  <main id="main" class="pt-20">
    <article class="max-w-3xl mx-auto px-6 md:px-10 py-16">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-8">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="hover:text-teal-400 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-300">Terms of Use</li>
        </ol>
      </nav>

      <h1 class="font-display text-3xl sm:text-4xl tracking-tight">Terms of Use</h1>
      <p class="mt-3 text-sm text-slate-400">Last updated: October 6, 2026</p>

      <div class="prose-blog mt-8">
        <p>
          By using brainlodestones.com you agree to these terms. If you do not agree,
          please do not use the site.
        </p>

        <h2>What this site is</h2>
        <p>
          This site markets a single domain name, <strong>brainlodestones.com</strong>,
          for sale. Content on the site — including descriptions, visuals, brand
          concepts, statistics, and projections — is provided for information and
          evaluation purposes. It is not medical, legal, financial, or investment
          advice, and nothing on the site constitutes a binding offer to sell until a
          definitive written agreement is executed.
        </p>

        <h2>Making an offer</h2>
        <ul>
          <li>An inquiry, message, or email is an expression of interest, not a contract.</li>
          <li>
            A price discussed or agreed in conversation remains subject to a signed
            purchase agreement and a funded escrow transaction.
          </li>
          <li>
            The domain is offered on an “as-is, where-is” basis with clean title,
            subject to prior sale and withdrawal at any time before agreement.
          </li>
          <li>
            Either party may end negotiations at any time before escrow agreement, for
            any reason.
          </li>
        </ul>

        <h2>Transactions and escrow</h2>
        <p>
          Completed acquisitions are processed through an escrow service or a
          brokered transaction. Funds are released and the domain is transferred
          according to that service's rules. You are responsible for your own due
          diligence, including trademark clearance and suitability of the name for
          your intended use.
        </p>

        <h2>Acceptable use</h2>
        <ul>
          <li>Do not probe, disrupt, or overload the site or its endpoints.</li>
          <li>Do not submit false, automated, or fraudulent inquiries.</li>
          <li>
            Do not misrepresent your identity, authority to buy, or affiliation with
            an organization.
          </li>
          <li>
            Do not attempt to circumvent the sale process by contacting parties other
            than the listed contact to transact around these terms.
          </li>
        </ul>

        <h2>Intellectual property</h2>
        <p>
          The site design, copy, logo concepts, and brand mockups on this site are
          presented for evaluation by prospective buyers. They may not be reproduced,
          published, or used commercially except as expressly included in a completed
          acquisition of the domain. Third-party names and marks referenced on the
          site remain the property of their respective owners.
        </p>

        <h2>Disclaimer of warranties</h2>
        <p>
          The site is provided “as is” without warranties of any kind, express or
          implied, including accuracy of market statistics and projections, which are
          based on publicly available information and are subject to change.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the maximum extent permitted by law, the operator of this site is not
          liable for any indirect, incidental, or consequential damages arising from
          use of the site or from reliance on its content.
        </p>

        <h2>Governing law</h2>
        <p>
          These terms are governed by the laws applicable at the operator's principal
          place of business, without regard to conflict-of-law rules.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about these terms: <a href={`mailto:${ACQUISITION_EMAIL}`}>{ACQUISITION_EMAIL}</a>.
          See also our <a href="/privacy/">Privacy Policy</a>.
        </p>
      </div>

      <div class="mt-12">
        <a
          href="/"
          class="inline-flex min-h-[48px] items-center rounded-2xl border border-slate-700 px-6 text-sm font-medium text-slate-300 transition-colors hover:border-teal-400/50 hover:text-white"
        >
          ← Back to brainlodestones.com
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
