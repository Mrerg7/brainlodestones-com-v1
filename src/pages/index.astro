  <script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const resetBtn = document.getElementById('reset-form-btn');
  const errorEl = document.getElementById('form-error');
  const honeypot = document.getElementById('website') as HTMLInputElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const originalButtonHtml = submitBtn?.innerHTML ?? 'Submit Inquiry';

  const field = (id: string) => document.getElementById(id);

  const setIdle = (busy: boolean) => {
    if (!submitBtn) return;
    submitBtn.disabled = busy;
    submitBtn.innerHTML = busy ? 'Sending…' : originalButtonHtml;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;
    errorEl?.classList.add('hidden');
    setIdle(true);

    try {
      const response = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source: 'form',
          name: (field('full-name') as HTMLInputElement | null)?.value ?? '',
          email: (field('email') as HTMLInputElement | null)?.value ?? '',
          phone: (field('phone') as HTMLInputElement | null)?.value ?? '',
          intendedUse: (field('intended-use') as HTMLSelectElement | null)?.value ?? '',
          message: (field('message') as HTMLTextAreaElement | null)?.value ?? '',
          website: honeypot?.value ?? '',
        }),
      });

      if (!response.ok) throw new Error(`request failed: ${response.status}`);

      form.style.display = 'none';
      successMsg?.classList.remove('hidden');
      successMsg?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      if (errorEl) {
        errorEl.innerHTML =
          'We could not send that just now. Please email ' +
          '<a class="underline underline-offset-4" href="mailto:sales@desertrich.com?subject=Domain%20inquiry%3A%20brainlodestones.com">sales@desertrich.com</a> ' +
          'and we will reply within 24 hours.';
        errorEl.classList.remove('hidden');
      }
      setIdle(false);
    }
  });

  resetBtn?.addEventListener('click', () => {
    if (!form) return;
    successMsg?.classList.add('hidden');
    form.style.display = 'block';
    form.reset();
    setIdle(false);
    (field('full-name') as HTMLInputElement | null)?.focus();
  });
</script>
