---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const title = 'Domain Insights & Guides | brainlodestones.com';
const description =
  'Practical guides on domain valuation, escrow transfers, and naming strategy for TMS networks, neurotech platforms, and premium .com acquisitions.';
---

<BaseLayout title={title} description={description}>
  <Nav />

  <main id="main" class="pt-20">
    <header class="border-b border-slate-800 bg-slate-900/50">
      <div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-16 md:py-20">
        <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-6">
          <ol class="flex flex-wrap items-center gap-x-2">
            <li><a href="/" class="hover:text-teal-400 transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-300">Insights</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <div class="uppercase text-teal-400 text-xs font-semibold tracking-[2px] mb-3">
            DOMAIN INSIGHTS
          </div>
          <h1 class="section-header tracking-tighter">
            Valuation, escrow, and naming strategy.
          </h1>
          <p class="mt-5 text-lg text-slate-300">
            Field notes for buyers and sellers of premium domains — how serious
            acquisitions are priced, structured, and transferred.
          </p>
        </div>
      </div>
    </header>

    <section class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-16" aria-labelledby="latest-guides">
      <h2 id="latest-guides" class="sr-only">Latest guides</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <article class="group relative flex flex-col rounded-3xl border border-slate-800 p-7 transition-all hover:border-teal-900/60 hover:bg-slate-900/40">
              <div class="font-mono text-xs tracking-widest text-teal-400 mb-3">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="text-slate-400"> · {post.data.readingMinutes} min</span>
              </div>
              <h2 class="text-xl font-semibold tracking-tight leading-snug group-hover:text-teal-400 transition-colors">
                <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 text-sm text-slate-400 flex-1">{post.data.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded-full bg-slate-800/70 px-3 py-1 text-[11px] text-slate-400">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <p class="text-slate-400">No posts published yet.</p>
        )
      }
    </section>

    <section class="border-t border-slate-800 bg-slate-900 py-14">
      <div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 text-center">
        <h2 class="font-display text-3xl tracking-tight">
          Ready to talk about a specific name?
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-400">
          brainlodestones.com is available for acquisition with escrow-protected
          transfer and flexible terms.
        </p>
        <a
          href="/#acquire"
          class="mt-7 inline-flex min-h-[52px] items-center justify-center rounded-2xl bg-teal-400 px-8 font-semibold text-slate-950 transition-colors hover:bg-teal-300"
        >
          Start an inquiry
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
