---
import {
  SITE_NAME,
  SITE_URL,
  HERO_IMAGE_URL,
  ACQUISITION_EMAIL,
} from '../lib/constants';
import { FAQS } from '../lib/faq';

interface Props {
  canonical: string;
}

const { canonical } = Astro.props;

const description =
  'brainlodestones.com — The premium plural .com domain for Transcranial Magnetic Stimulation networks, neurotechnology platforms, and multi-center brain health innovation. Instant authority in the growing TMS ecosystem.';

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'brainlodestones.com | Premium Domain for Sale | TMS Networks',
  description,
  url: canonical,
  inLanguage: 'en-US',
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: HERO_IMAGE_URL,
    contentUrl: HERO_IMAGE_URL,
    width: 1144,
    height: 768,
  },
  about: {
    '@type': 'Thing',
    name: 'Transcranial Magnetic Stimulation',
    description:
      'Premium domain name asset for TMS clinic networks, neurotechnology platforms, and multi-center brain health innovation.',
  },
};

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'en-US',
  description,
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: canonical,
  email: ACQUISITION_EMAIL,
  logo: HERO_IMAGE_URL,
  description,
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${canonical}#faq`,
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'brainlodestones.com domain name',
  description:
    'Premium plural .com domain for TMS networks, neurotechnology platforms, and multi-center brain health innovation. A powerful, scalable brand asset.',
  category: 'Domain Name',
  image: {
    '@type': 'ImageObject',
    url: HERO_IMAGE_URL,
    contentUrl: HERO_IMAGE_URL,
  },
  brand: {
    '@type': 'Brand',
    name: SITE_NAME,
  },
  sku: 'brainlodestones-com',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    bestRating: '5',
    worstRating: '1',
    reviewCount: '1',
  },
  review: {
    '@type': 'Review',
    name: 'Premium domain name asset',
    reviewBody:
      'brainlodestones.com is a premium plural .com domain name ideal for TMS clinic networks and neurotechnology platforms. An authoritative and memorable brand asset in the growing brain health market.',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: '5',
      bestRating: '5',
      worstRating: '1',
    },
    author: {
      '@type': 'Organization',
      name: SITE_NAME,
    },
    datePublished: '2025-07-24',
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    price: '14997',
    priceCurrency: 'USD',
    url: canonical,
    seller: {
      '@type': 'Organization',
      name: SITE_NAME,
      email: ACQUISITION_EMAIL,
      url: canonical,
    },
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0.00',
        currency: 'USD',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 1,
          unitCode: 'd',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 0,
          maxValue: 0,
          unitCode: 'd',
        },
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'US',
      },
    },
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/FreeReturn',
      applicableCountry: 'US',
      merchantReturnDays: 0,
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" set:html={JSON.stringify(webSite)} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
<script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
<script type="application/ld+json" set:html={JSON.stringify(product)} />
