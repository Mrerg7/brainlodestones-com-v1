<div
  id="exit-intent"
  class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4"
>
  <div class="absolute inset-0 bg-slate-950/85 backdrop-blur-sm" data-exit-close></div>

  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="exit-intent-title"
    class="relative w-full max-w-lg overflow-hidden rounded-3xl border border-slate-700 bg-slate-900 p-8 shadow-2xl"
  >
    <button
      type="button"
      class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-2xl text-slate-400 transition-colors hover:bg-slate-800 hover:text-white"
      aria-label="Close"
      data-exit-close
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6h12v12"></path>
      </svg>
    </button>

    <div id="exit-intent-content">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full bg-teal-400/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[2px] text-teal-400"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
        Before you go
      </div>

      <h2 id="exit-intent-title" class="font-display text-3xl tracking-tight">
        Considering <span class="gradient-text">brainlodestones.com</span>?
      </h2>

      <p class="mt-3 text-sm leading-relaxed text-slate-300">
        Leave your email and we will send acquisition terms, escrow details, and
        transfer timelines — no obligation, strictly confidential.
      </p>

      <form id="exit-intent-form" class="mt-6 space-y-4">
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <label class="block text-xs font-medium tracking-wider text-slate-400" for="exit-email">
          EMAIL ADDRESS
        </label>
        <input
          type="email"
          id="exit-email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class="form-input w-full rounded-2xl border border-slate-700 bg-slate-950 px-5 py-4 text-sm text-white outline-none placeholder:text-slate-500"
        />
        <button
          type="submit"
          class="flex min-h-[52px] w-full items-center justify-center gap-x-2 rounded-2xl bg-teal-400 px-6 py-4 font-semibold text-slate-950 transition-colors hover:bg-teal-300"
        >
          Send me acquisition terms
        </button>
        <p id="exit-intent-error" class="hidden text-xs text-rose-300" role="alert"></p>
        <p class="text-center text-[10px] text-slate-400">
          We respond within 24 hours. No lists, no spam — one reply from a human.
        </p>
      </form>
    </div>

    <div id="exit-intent-success" class="hidden py-6 text-center">
      <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-teal-400/10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7 text-teal-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold tracking-tight">Terms are on the way.</h3>
      <p class="mt-2 text-sm text-slate-300">
        Check your inbox within 24 hours. Want to talk sooner?
        <a class="text-teal-400 underline underline-offset-4" href="/#acquire">Send an inquiry</a>.
      </p>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'bl-exit-intent-seen';
  const modal = document.getElementById('exit-intent');
  const form = document.getElementById('exit-intent-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('exit-intent-error');
  const successEl = document.getElementById('exit-intent-success');
  const contentEl = document.getElementById('exit-intent-content');
  const emailInput = document.getElementById('exit-email') as HTMLInputElement | null;

  const wasSeen = () => {
    try {
      return sessionStorage.getItem(STORAGE_KEY) === '1';
    } catch {
      return true;
    }
  };

  const markSeen = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, '1');
    } catch {
      /* storage blocked — just don't show again this load */
    }
  };

  const openModal = () => {
    if (!modal || wasSeen()) return;
    markSeen();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    window.setTimeout(() => emailInput?.focus(), 60);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  if (modal && !wasSeen()) {
    document.addEventListener('mouseout', (event: MouseEvent) => {
      if (event.clientY <= 0 && !event.relatedTarget && !event.buttons) openModal();
    });

    modal.querySelectorAll<HTMLElement>('[data-exit-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    // Navigating to the form from the modal should close it
    modal.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', closeModal);
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }
      errorEl?.classList.add('hidden');

      try {
        const response = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source: 'exit-intent',
            email: emailInput?.value ?? '',
            message: 'Please send acquisition terms, escrow details, and transfer timelines.',
          }),
        });

        if (!response.ok) throw new Error('request-failed');

        contentEl?.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } catch {
        if (errorEl) {
          errorEl.textContent =
            'Something went wrong. Email sales@desertrich.com directly and we will reply within 24 hours.';
          errorEl.classList.remove('hidden');
        }
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send me acquisition terms';
        }
      }
    });
  }
</script>
