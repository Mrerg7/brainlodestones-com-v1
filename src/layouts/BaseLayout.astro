---
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
import ExitIntent from '../components/ExitIntent.astro';
import { SITE_NAME, HERO_IMAGE_URL, getCanonicalUrl } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'brainlodestones.com | Premium Domain for Sale | TMS Networks',
  description = 'Available now: brainlodestones.com — a premium plural .com for TMS clinic networks and neurotech platforms. Escrow-protected transfer, flexible terms. Inquire today.',
  noindex = false,
} = Astro.props;

const canonical = getCanonicalUrl(Astro.url.pathname);
const ogImage = HERO_IMAGE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1"
        />
      )
    }
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="dark" />
    <meta name="google-site-verification" content="bOJbobh47tjbnbrMAMEaA5yS_sui2SDrvgfaI1mITKE" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content="brainlodestones.com — premium TMS network & brain health domain" />
    <meta property="og:image:width" content="1144" />
    <meta property="og:image:height" content="768" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="brainlodestones.com" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted fonts: preload the two latin subsets (70 KB total), no third-party CSS -->
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Hero is the LCP element -->
    <link rel="preload" as="image" href={HERO_IMAGE_URL} fetchpriority="high" />

    <link rel="preconnect" href="https://imagedelivery.net" />

    {!noindex && <StructuredData canonical={canonical} />}

    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-slate-200 overflow-x-hidden antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-2xl focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-slate-900"
    >
      Skip to content
    </a>
    <slot />
    <ExitIntent />
    <script>
      const nav = document.getElementById('nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 50) {
            nav.classList.add('nav-scrolled');
          } else {
            nav.classList.remove('nav-scrolled');
          }
        });
      }
    </script>
  </body>
</html>
